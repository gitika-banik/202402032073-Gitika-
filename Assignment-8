#include <stdio.h>

int a[20][20], visited[20], n;

int cycle(int v, int parent)
{
    visited[v] = 1;

    for (int i = 0; i < n; i++)
    {
        if (a[v][i])
        {
            if (!visited[i])
            {
                if (cycle(i, v))
                    return 1;
            }
            else if (i != parent)
                return 1;
        }
    }
    return 0;
}

int main()
{
    int i, j, found = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    for (i = 0; i < n; i++)
        visited[i] = 0;

    for (i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            if (cycle(i, -1))
            {
                found = 1;
                break;
            }
        }
    }

    if (found)
        printf("Cycle exists");
    else
        printf("No cycle exists");

    return 0;
}
