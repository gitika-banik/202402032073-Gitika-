#include <stdio.h>

int main()
{
    int a[20][20], n;
    int min, max, i, j;
    int minU, minV, maxU, maxV;
    int found = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter weighted adjacency matrix:\n");

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    for (i = 0; i < n; i++)
    {
        for (j = i + 1; j < n; j++)
        {
            if (a[i][j] != 0)
            {
                if (!found)
                {
                    min = max = a[i][j];
                    minU = maxU = i;
                    minV = maxV = j;
                    found = 1;
                }
                else
                {
                    if (a[i][j] < min)
                    {
                        min = a[i][j];
                        minU = i;
                        minV = j;
                    }

                    if (a[i][j] > max)
                    {
                        max = a[i][j];
                        maxU = i;
                        maxV = j;
                    }
                }
            }
        }
    }

    if (found)
    {
        printf("Lowest weight edge: %d-%d = %d\n",
               minU, minV, min);

        printf("Highest weight edge: %d-%d = %d\n",
               maxU, maxV, max);
    }
    else
        printf("No edges found");

    return 0;
}
