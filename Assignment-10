#include <stdio.h>

int main()
{
    int a[20][20], degree[20];
    int n, i, j;
    int max, min, maxV, minV;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &a[i][j]);

    for (i = 0; i < n; i++)
    {
        degree[i] = 0;

        for (j = 0; j < n; j++)
            degree[i] += a[i][j];
    }

    max = min = degree[0];
    maxV = minV = 0;

    for (i = 1; i < n; i++)
    {
        if (degree[i] > max)
        {
            max = degree[i];
            maxV = i;
        }

        if (degree[i] < min)
        {
            min = degree[i];
            minV = i;
        }
    }

    printf("Vertex with highest degree: %d\n", maxV);
    printf("Highest degree: %d\n", max);

    printf("Vertex with lowest degree: %d\n", minV);
    printf("Lowest degree: %d\n", min);

    return 0;
}
